# ═══════════════════════════════════════════
# ZORUNLU — yalnızca 2 token (+ grup id)
# ═══════════════════════════════════════════

# 1) Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_CHAT_ID=-1001234567890

# 2) GitHub
GITHUB_TOKEN=ghp_xxx

# ═══════════════════════════════════════════
# Ollama — PROJEYE GÖMÜLÜ (API KEY YOK)
# Docker/Railway: start.sh otomatik başlatır
# ═══════════════════════════════════════════
# Genelde dokunma; container içi adres:
# OLLAMA_BASE_URL=http://127.0.0.1:11434
#
# Küçük model = Railway için uygun (varsayılan)
OLLAMA_MODEL=llama3.2:1b
# Daha kaliteli (daha çok RAM): llama3.2  |  llama3.2:3b
# OLLAMA_TIMEOUT_SECONDS=180

# ── Opsiyonel bot ayarları ──
# Rising eşiği (pencere içi star artışı)
MIN_STARS_24H=5
# MAX_CANDIDATES=40
# MAX_NOTIFICATIONS_PER_SCAN=8
# Bir kerelik: bugün sabahtan (TR) itibaren — DB'de işlenir, tekrarlanmaz
# MORNING_CATCHUP_ONCE=true
# CATCHUP_MAX_NOTIFICATIONS=25
# CATCHUP_TIMEZONE=Europe/Istanbul
# DEDUP_HOURS=48
# SCAN_INTERVAL_SECONDS=600
# DATABASE_PATH=./data/bot.db
# PORT=8080
# LOG_LEVEL=INFO
